# 이 파일은 템플릿입니다 (키 값 없이 커밋됨).
# 실제 키는 .env 파일에 넣으세요.

# OpenAI API 키: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 이미지 생성 모델 (gpt-image-1 권장 / 대안: dall-e-3)
OPENAI_IMAGE_MODEL=gpt-image-1
# 배경 크기 (세로형): 1024x1536 | 1024x1024 | 1536x1024 | auto
OPENAI_IMAGE_SIZE=1024x1536
# gpt-image-1 화질: low | medium | high | auto
OPENAI_IMAGE_QUALITY=high
OPENAI_VISION_MODEL=gpt-4o-mini

# 스톡 사람 사진(#6) — 택1
STOCK_PROVIDER=pexels
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
